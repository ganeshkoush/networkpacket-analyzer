{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PacketMind",
  "version": "0.1.0",
  "identifier": "com.packetmind.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PacketMind",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "public.app-category.developer-tools",
    "shortDescription": "AI-assisted network traffic analysis",
    "longDescription": "PacketMind analyzes PCAP captures and live traffic locally and explains findings with evidence.",
    "copyright": "Copyright \u00a9 PacketMind",
    "resources": {
      "../../build/backend-dist/packetmind-backend": "backend",
      "../../scripts/macos-bpf-access.sh": "scripts/macos-bpf-access.sh"
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "dmg": {
        "windowSize": {
          "width": 600,
          "height": 400
        }
      }
    }
  }
}
