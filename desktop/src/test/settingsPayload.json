 "unavailable": {
  "general": [
   {
    "key": "start_on_login",
    "label": "Start application on login",
    "reason": "Not available yet: the desktop shell has no login-item support."
   },
   {
    "key": "minimize_to_tray",
    "label": "Minimize to system tray",
    "reason": "Not available yet: the desktop shell has no system-tray support."
   }
  ],
  "capture": [
   {
    "key": "buffer_size",
    "label": "Capture buffer size",
    "reason": "The capture library (Scapy/libpcap) is opened with its default buffer; PacketMind cannot change it."
   }
  ],
  "analysis": [
   {
    "key": "udp",
    "label": "Enable UDP analysis",
    "reason": "There is no separate UDP analyzer: UDP is part of the protocol, port, connection and DNS analysis."
   },
   {
    "key": "tls_metadata",
    "label": "Enable TLS metadata analysis",
    "reason": "PacketMind only recognises TLS to tell encrypted from cleartext traffic; it does not read certificates or server names."
   },
   {
    "key": "store_packet_metadata",
    "label": "Store packet metadata",
    "reason": "PacketMind never keeps per-packet metadata: results are aggregates only."
   },
   {
    "key": "max_memory",
    "label": "Maximum analysis memory",
    "reason": "Memory is bounded by fixed caps (see Analysis depth), not by a byte limit."
   }
  ],
  "detection": [
   {
    "key": "time_window",
    "label": "Port scan / SYN flood time window",
    "reason": "Detectors work on whole-capture aggregates, so they have no sliding time window to configure."
   }
  ],
  "domains": [
   {
    "key": "group_subdomains",
    "label": "Group subdomains",
    "reason": "Grouping needs a public-suffix list that PacketMind does not ship; grouping by the last two labels would be wrong for names like example.co.uk."
   },
   {
    "key": "track_destination_ips",
    "label": "Track destination IPs",
    "reason": "Destination IPs are always part of the analysis; they cannot be turned off without breaking connections and findings."
   }
  ],
  "ai": [
   {
    "key": "max_tool_calls",
    "label": "Maximum tool calls",
    "reason": "The model cannot call tools. PacketMind runs a fixed read-only set of local analysis functions itself, so there is nothing to cap."
   },
   {
    "key": "auto_anomalies",
    "label": "Automatically investigate performance anomalies",
    "reason": "Automatic investigation only runs for live-capture security findings."
   }
  ],
  "ai_usage": [
   {
    "key": "per_capture_limit",
    "label": "Maximum investigations per capture",
    "reason": "Requests are counted per day, not per capture."
   }
  ],
  "security": [
   {
    "key": "external_integrations",
    "label": "Allow external integrations",
    "reason": "PacketMind has no external integrations, so there is nothing to allow."
   }
  ],
  "advanced": [
   {
    "key": "max_concurrent_captures",
    "label": "Maximum concurrent captures",
    "reason": "PacketMind supports one live capture at a time."
   },
   {
    "key": "developer_tools",
    "label": "Developer tools",
    "reason": "Not exposed in release builds."
   },
   {
    "key": "experimental",
    "label": "Experimental features",
    "reason": "There are no experimental features in this version."
   }
  ]
 },
