# Copy to .env (git-ignored) and fill in. Never commit real keys.
# AI investigation is optional; everything else works without a key.
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-2.5-flash
# GEMINI_TIMEOUT_SECONDS=60
# GEMINI_MAX_OUTPUT_TOKENS=4096

# Backend (all optional)
# PACKETMIND_LOG_LEVEL=INFO
# PACKETMIND_MAX_UPLOAD_BYTES=4294967296
# PACKETMIND_MAX_RETAINED_ANALYSES=10
