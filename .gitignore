# User data (captures can contain sensitive traffic). Saved and imported capture files live in captures/ (and are staged in
# backend/data/uploads/ while importing); exported copies and stray captures in the project root are ignored too.
captures/*
!captures/.gitkeep
/*.pcap
/*.pcapng
backend/data/
reports/*
!reports/.gitkeep

